# ===== Dr. Davi Menezes — config de produção (Hostinger / LiteSpeed-Apache) =====

# Documento padrão
DirectoryIndex index.html

# Não listar arquivos das pastas (segurança)
Options -Indexes

# Forçar HTTPS (a Hostinger provisiona SSL automaticamente)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml font/woff2
</IfModule>

# Cache do navegador
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp          "access plus 1 year"
  ExpiresByType image/jpeg          "access plus 1 year"
  ExpiresByType image/png           "access plus 1 year"
  ExpiresByType image/svg+xml       "access plus 1 year"
  ExpiresByType image/x-icon        "access plus 1 year"
  ExpiresByType font/woff2          "access plus 1 year"
  ExpiresByType text/html           "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  # Cache imutável para assets versionáveis (fontes/imagens)
  <FilesMatch "\.(woff2|webp|jpg|jpeg|png|ico|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Cabeçalhos de segurança (recomendados em produção)
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# MIME correto (servidores antigos)
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

# Página de erro volta para a home (site de página única).
# OBS.: se você publicar dentro de uma SUBPASTA (ex.: /lifting/), troque a
# linha abaixo por:  ErrorDocument 404 /lifting/index.html
ErrorDocument 404 /index.html
